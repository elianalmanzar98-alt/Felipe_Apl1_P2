@page "/Venta/Registro"
@page "/Venta/Registro/{VentaId:int}"
@using Felipe_Ap1_P2.Models
@using Felipe_Ap1_P2.Services
@inject VentaService ventaService
@inject NavigationManager navigationManager
@rendermode InteractiveServer

<PageTitle>Registro de Ventas</PageTitle>

<EditForm Model="venta" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="card shadow-lg m-4">
        <div class="card-header">
            <h5 class="mb-0">Registro de Ventas</h5>
        </div>

        <div class="card-body">
            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert alert-@tipoMensaje alert-dismissible fade show">
                    @mensaje
                    <button type="button" class="btn-close" @onclick="() => mensaje = null"></button>
                </div>
            }

            <div class="mb-3">
                <label class="form-label fw-bold">Venta Id</label>
                <div class="input-group">
                    <InputNumber class="form-control" @bind-Value="venta.VentaId" />
                    <button type="button" class="btn btn-outline-primary" @onclick="Buscar">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Fecha</label>
                <InputDate class="form-control" @bind-Value="venta.Fecha" />
                <ValidationMessage For="@(() => venta.Fecha)" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Observación</label>
                <InputText class="form-control" @bind-Value="venta.Observacion" />
                <ValidationMessage For="@(() => venta.Observacion)" />
            </div>

            @* ===== DETALLE: productos vendidos ===== *@
            <div class="border border-success rounded p-3">
                <h5>Productos de la venta</h5>

                <div class="row g-2 align-items-end mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Producto</label>
                        <select class="form-select" @bind="productoId" @bind:after="CargarPrecio">
                            <option value="0">Seleccione un producto</option>
                            @foreach (var p in productos)
                            {
                                <option value="@p.ProductoId">@p.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Precio</label>
                        <label class="form-control bg-light">@precioSeleccionado.ToString("N2")</label>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Stock disponible</label>
                        <label class="form-control bg-light">@stockSeleccionado</label>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Cantidad</label>
                        <input type="number" min="1" class="form-control" @bind="cantidad" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-primary" @onclick="Agregar">
                            <i class="bi bi-plus-lg"></i> Agregar
                        </button>
                    </div>
                </div>

                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th class="text-end">Cantidad</th>
                            <th class="text-end">Precio</th>
                            <th class="text-end">Subtotal</th>
                            <th style="width:130px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in venta.Detalles)
                        {
                            <tr>
                                <td>@productos.FirstOrDefault(p => p.ProductoId == d.ProductoId)?.Nombre</td>
                                <td class="text-end">@d.Cantidad</td>
                                <td class="text-end">@d.Precio.ToString("N2")</td>
                                <td class="text-end">@((d.Cantidad * d.Precio).ToString("N2"))</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => QuitarDetalle(d)">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="row justify-content-end">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Total</label>
                        <label class="form-control bg-light fw-bold">@venta.Total.ToString("N2")</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer text-center">
            <a href="/Venta/Index" class="btn btn-secondary"><i class="bi bi-list-ul me-1"></i> Consulta</a>
            <button type="button" class="btn btn-outline-primary" @onclick="Nuevo"><i class="bi bi-file-earmark-plus me-1"></i> Nuevo</button>
            <button type="submit" class="btn btn-outline-success"><i class="bi bi-floppy me-1"></i> Guardar</button>
            <button type="button" class="btn btn-outline-danger" @onclick="Eliminar"><i class="bi bi-trash me-1"></i> Eliminar</button>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public int VentaId { get; set; }

    private Ventas venta = new();
    private List<Productos> productos = new();

   
    private Dictionary<int, int> originales = new();

    private int productoId = 0;
    private int cantidad = 1;
    private decimal precioSeleccionado = 0;
    private int stockSeleccionado = 0;

    private string? mensaje;
    private string tipoMensaje = "success";

    protected override async Task OnInitializedAsync()
    {
        productos = await ventaService.ListarProductos();

        if (VentaId > 0)
        {
            venta.VentaId = VentaId;
            await Buscar();
        }
    }

    private void Notificar(string tipo, string texto)
    {
        tipoMensaje = tipo;
        mensaje = texto;
    }

   
    private int StockDisponible(Productos producto)
    {
        return producto.Stock + (originales.TryGetValue(producto.ProductoId, out var cant) ? cant : 0);
    }

   
    private void CargarPrecio()
    {
        var producto = productos.FirstOrDefault(p => p.ProductoId == productoId);
        precioSeleccionado = producto?.Precio ?? 0;
        stockSeleccionado = producto != null ? StockDisponible(producto) : 0;
    }

    private void Recalcular()
    {
        venta.Total = venta.Detalles.Sum(d => d.Cantidad * d.Precio);
    }

    private async Task Nuevo()
    {
        venta = new Ventas();
        originales = new Dictionary<int, int>();
        productos = await ventaService.ListarProductos();  
        productoId = 0;
        cantidad = 1;
        CargarPrecio();
        mensaje = null;
    }

    private async Task Buscar()
    {
        mensaje = null;

        if (venta.VentaId <= 0)
        {
            Notificar("warning", "Digite un Id para buscar");
            return;
        }

        var resultado = await ventaService.Buscar(venta.VentaId);
        if (resultado.IsSuccess && resultado.Value != null)
        {
            venta = resultado.Value;

            productos = await ventaService.ListarProductos();
            originales = venta.Detalles
                .GroupBy(d => d.ProductoId)
                .ToDictionary(g => g.Key, g => g.Sum(d => d.Cantidad));

            productoId = 0;
            cantidad = 1;
            CargarPrecio();
        }
        else
        {
            Notificar("danger", "registro no encontrado");
        }
    }

    
    private void Agregar()
    {
        mensaje = null;

        if (productoId == 0)
        {
            Notificar("warning", "seleccione un producto");
            return;
        }

        if (cantidad <= 0)
        {
            Notificar("warning", "La cantidad debe ser mayor que 0");
            return;
        }

        var producto = productos.First(p => p.ProductoId == productoId);
        var existente = venta.Detalles.FirstOrDefault(d => d.ProductoId == productoId);
        var cantidadTotal = cantidad + (existente?.Cantidad ?? 0);
        var disponible = StockDisponible(producto);

        if (cantidadTotal > disponible)
        {
            Notificar("warning", $"Stock insuficiente de {producto.Nombre}. Disponible: {disponible}");
            return;
        }

        if (existente != null)
        {
            existente.Cantidad = cantidadTotal;     
        }
        else
        {
            venta.Detalles.Add(new VentasDetalle
            {
                ProductoId = productoId,
                Cantidad = cantidad,
                Precio = producto.Precio
            });
        }

        Recalcular();
        productoId = 0;
        cantidad = 1;
        CargarPrecio();
    }

    private void QuitarDetalle(VentasDetalle detalle)
    {
        venta.Detalles.Remove(detalle);
        Recalcular();
    }

   
    private async Task Guardar()
    {
        mensaje = null;

        var resultado = await ventaService.Guardar(venta);
        if (resultado.IsSuccess)
        {
            navigationManager.NavigateTo("/Venta/Index?mensaje=guardada");
        }
        else
        {
            
            Notificar(venta.Detalles.Any() ? "danger" : "warning", "No se pudo guardar la venta.");
        }
    }

    private async Task Eliminar()
    {
        mensaje = null;

        if (venta.VentaId <= 0)
        {
            Notificar("warning", "Busque primero la venta que desea eliminar.");
            return;
        }

        var resultado = await ventaService.Eliminar(venta.VentaId);
        if (resultado.IsSuccess)
        {
            navigationManager.NavigateTo("/Venta/Index?mensaje=eliminada");
        }
        else
        {
            Notificar("danger", "No se pudo eliminar la venta.");
        }
    }
}